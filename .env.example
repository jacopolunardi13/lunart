# LunArt — Guest Guide & Commerce
#
# Copy to .env and fill in. Never commit the filled-in version: .env is ignored.
# The server reads these at boot; nothing secret is stored in the repository.

# Where the guide answers. Used to build Stripe's return URLs.
PUBLIC_URL=http://localhost:4173
PORT=4173

# ── Stripe ──────────────────────────────────────────────────────────────────
# Leave STRIPE_SECRET_KEY empty to run the built-in mock checkout: the whole flow
# works end to end, no money moves, and nothing talks to Stripe.
# Start with the test keys (sk_test_... / pk_test_...).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` or the dashboard. Without it, webhooks are refused.
STRIPE_WEBHOOK_SECRET=

# ── Privilege Card ──────────────────────────────────────────────────────────
# Signs the rotating card codes. 32+ random bytes, hex:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If this is missing a random one is generated at boot, which invalidates every
# issued card on every restart. Set it before anybody holds a real card.
CARD_SIGNING_KEY=
CARD_CODE_PERIOD_SECONDS=60
CARD_CODE_GRACE=1

# ── Operations ──────────────────────────────────────────────────────────────
# Protects the provider confirm/decline endpoints. Any long random string.
STAFF_TOKEN=

# Where orders and cards are written. Empty keeps them in memory, which is fine
# for a preview and loses everything on restart.
LUNART_DATA_DIR=

# Sell items whose price LunArt has not confirmed. Leave off in production.
ALLOW_PLACEHOLDER_PRICES=
# Fill the unpriced products with obviously-fake values so the flow can be walked.
LUNART_DEV_PRICES=
